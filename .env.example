# Copiez ce fichier en .env puis adaptez les valeurs. Aucune clé secrète ici : tout est public côté navigateur.

# URL publique du site (sert aux liens canoniques). Exemple : https://www.pixelplay.cm
VITE_SITE_URL=

# Affiche le bandeau « données de démonstration » sur les catalogues.
# Passez à false une fois les vrais produits, prix et stocks saisis dans src/data/.
VITE_SHOW_DEMO_NOTICE=true

# Photos du formulaire « Vendre mon appareil »
VITE_MAX_PHOTOS=6
VITE_MAX_PHOTO_MB=5
